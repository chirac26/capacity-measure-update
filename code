<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">

<meta name="viewport"
      content="width=device-width, initial-scale=1.0,
               maximum-scale=1.0, user-scalable=no">

<meta name="theme-color" content="#0f172a">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="CAPACITY MEASURE">

<title>CAPACITY MEASURE</title>

<script src="https://cdn.tailwindcss.com"></script>

<style>

/* =========================================================
   CAPACITY MEASURE
   CSS
   ========================================================= */

* {
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
}

:root {
    --primary: #2563eb;
    --primary-dark: #1d4ed8;
    --dark: #0f172a;
    --dark2: #1e293b;
    --bg: #f1f5f9;
    --card: #ffffff;
    --text: #0f172a;
    --muted: #64748b;
    --border: #e2e8f0;
    --success: #16a34a;
    --danger: #dc2626;
    --warning: #d97706;
}

body {
    margin: 0;
    font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        Helvetica,
        Arial,
        sans-serif;

    background: var(--bg);
    color: var(--text);
}

button,
input,
select,
textarea {
    font: inherit;
}

button {
    cursor: pointer;
}

.hidden {
    display: none !important;
}


/* =========================================================
   HEADER
   ========================================================= */

.app-header {
    background:
        linear-gradient(
            135deg,
            #0f172a,
            #1e3a8a
        );

    color: white;

    padding: 18px 16px;

    position: sticky;
    top: 0;

    z-index: 50;

    box-shadow:
        0 3px 15px rgba(0,0,0,.18);
}

.header-inner {
    max-width: 1100px;
    margin: auto;
}

.logo {
    font-size: 21px;
    font-weight: 800;
    letter-spacing: .5px;
}

.subtitle {
    font-size: 12px;
    opacity: .75;
    margin-top: 3px;
}


/* =========================================================
   CONTAINER
   ========================================================= */

.container {
    max-width: 1100px;
    margin: auto;
    padding: 16px;
}


/* =========================================================
   NAVIGATION
   ========================================================= */

.nav {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 7px;
    margin-bottom: 18px;
}

.nav button {
    border: none;
    background: white;
    color: var(--muted);
    padding: 12px 6px;
    border-radius: 12px;
    font-weight: 700;
    font-size: 12px;

    box-shadow:
        0 2px 8px rgba(0,0,0,.06);
}

.nav button.active {
    background: var(--primary);
    color: white;
}


/* =========================================================
   CARDS
   ========================================================= */

.card {
    background: white;
    border-radius: 16px;
    padding: 17px;
    margin-bottom: 15px;

    box-shadow:
        0 3px 15px rgba(15,23,42,.07);
}

.card-title {
    font-size: 17px;
    font-weight: 800;
    margin-bottom: 13px;
}

.page-title {
    font-size: 23px;
    font-weight: 800;
    margin: 5px 0 3px;
}

.page-subtitle {
    color: var(--muted);
    font-size: 13px;
    margin-bottom: 18px;
}


/* =========================================================
   FORM
   ========================================================= */

label {
    display: block;
    font-size: 12px;
    font-weight: 700;
    color: #475569;
    margin-bottom: 6px;
}

input,
select,
textarea {
    width: 100%;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 12px;
    outline: none;
    background: white;
    color: var(--text);
}

input:focus,
select:focus,
textarea:focus {
    border-color: var(--primary);

    box-shadow:
        0 0 0 3px rgba(37,99,235,.1);
}

textarea {
    min-height: 90px;
    resize: vertical;
}

.form-group {
    margin-bottom: 13px;
}


/* =========================================================
   BUTTONS
   ========================================================= */

.btn {
    border: none;
    border-radius: 10px;
    padding: 12px 15px;
    font-weight: 750;
    transition: .15s;
}

.btn:active {
    transform: scale(.97);
}

.btn-primary {
    background: var(--primary);
    color: white;
}

.btn-primary:hover {
    background: var(--primary-dark);
}

.btn-success {
    background: var(--success);
    color: white;
}

.btn-danger {
    background: var(--danger);
    color: white;
}

.btn-warning {
    background: var(--warning);
    color: white;
}

.btn-secondary {
    background: #e2e8f0;
    color: #334155;
}

.btn-dark {
    background: var(--dark);
    color: white;
}

.btn-small {
    padding: 8px 10px;
    font-size: 12px;
}

.btn-full {
    width: 100%;
}

.button-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}


/* =========================================================
   STYLES
   ========================================================= */

.style-card {
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 14px;
    margin-bottom: 10px;
}

.style-name {
    font-weight: 800;
    font-size: 16px;
}

.style-client {
    color: var(--primary);
    font-size: 12px;
    margin-top: 3px;
}

.style-description {
    color: var(--muted);
    font-size: 12px;
    margin-top: 6px;
}

.operation-count {
    font-size: 11px;
    color: var(--muted);
    margin-top: 8px;
}

.operation-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;

    border-bottom: 1px solid var(--border);

    padding: 11px 0;
}

.operation-row:last-child {
    border-bottom: none;
}

.operation-info {
    flex: 1;
}

.operation-name {
    font-weight: 700;
    font-size: 14px;
}

.smv {
    color: var(--primary);
    font-size: 12px;
    margin-top: 3px;
}

.operation-actions {
    display: flex;
    gap: 5px;
}


/* =========================================================
   EMPTY
   ========================================================= */

.empty {
    text-align: center;
    padding: 35px 15px;
    color: var(--muted);
}

.empty-icon {
    font-size: 40px;
    margin-bottom: 10px;
}


/* =========================================================
   MEASURE
   ========================================================= */

.measure-card {
    background:
        linear-gradient(
            135deg,
            #0f172a,
            #1e3a8a
        );

    color: white;

    border-radius: 18px;
    padding: 18px;
    margin-bottom: 15px;
}

.measure-number {
    font-size: 12px;
    opacity: .7;
}

.measure-operation {
    font-size: 23px;
    font-weight: 850;
    margin: 6px 0;
}

.measure-meta {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}

.badge {
    display: inline-block;
    padding: 5px 8px;
    border-radius: 7px;
    font-size: 11px;
    font-weight: 700;
}

.badge-white {
    background: rgba(255,255,255,.14);
    color: white;
}

.operator-card {
    background: white;
    border-radius: 15px;
    padding: 15px;
    margin-bottom: 14px;
}


/* =========================================================
   TIMER
   ========================================================= */

.timer {
    font-size: 46px;
    font-weight: 800;
    text-align: center;
    letter-spacing: 1px;
    font-variant-numeric: tabular-nums;
    margin: 15px 0;
}

.timer.running {
    color: var(--success);
}

.timer-stopped {
    color: var(--muted);
}

.timer-buttons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
}

.timer-buttons button {
    min-height: 54px;
    font-size: 14px;
}


/* =========================================================
   CYCLES
   ========================================================= */

.cycles-title {
    font-size: 13px;
    font-weight: 800;
    margin: 18px 0 8px;
}

.cycles {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.cycle-item {
    display: flex;
    justify-content: space-between;
    align-items: center;

    background: #f8fafc;

    border: 1px solid var(--border);

    border-radius: 9px;

    padding: 9px 11px;

    font-size: 12px;
}

.cycle-time {
    font-weight: 800;
}

.next-button {
    margin-top: 15px;
}


/* =========================================================
   PROGRESS
   ========================================================= */

.progress {
    height: 7px;
    background: #e2e8f0;
    border-radius: 20px;
    overflow: hidden;
    margin: 10px 0 18px;
}

.progress-bar {
    height: 100%;
    background: var(--primary);
    transition: width .2s;
}


/* =========================================================
   TABLE RESULTS
   ========================================================= */

.table-container {
    overflow-x: auto;
    border-radius: 12px;
    border: 1px solid var(--border);
}

table {
    border-collapse: collapse;
    width: 100%;
    min-width: 1100px;
    background: white;
}

th {
    background: #0f172a;
    color: white;
    padding: 10px;
    font-size: 11px;
    text-align: left;
    white-space: nowrap;
}

td {
    border-bottom: 1px solid var(--border);
    padding: 10px;
    font-size: 12px;
    white-space: nowrap;
}

td.number {
    text-align: right;
    font-variant-numeric: tabular-nums;
}

.efficiency {
    font-weight: 800;
}


/* =========================================================
   CYCLE DISPLAY DANS RESULTATS
   ========================================================= */

.cycles-result {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;

    min-width: 240px;

    white-space: normal;
}

.cycle-result-badge {
    display: inline-flex;
    align-items: center;

    background: #eff6ff;
    color: #1d4ed8;

    border: 1px solid #bfdbfe;

    border-radius: 7px;

    padding: 5px 7px;

    font-size: 11px;
    font-weight: 700;

    white-space: nowrap;
}

.cycle-result-badge.average {
    background: #f0fdf4;
    color: #15803d;
    border-color: #bbf7d0;
}

.cycles-result-empty {
    color: #94a3b8;
    font-size: 11px;
}


/* =========================================================
   SUMMARY
   ========================================================= */

.summary-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-bottom: 15px;
}

.summary-box {
    background: white;
    padding: 14px;
    border-radius: 13px;

    box-shadow:
        0 2px 10px rgba(0,0,0,.05);
}

.summary-label {
    color: var(--muted);
    font-size: 11px;
}

.summary-value {
    font-size: 22px;
    font-weight: 850;
    margin-top: 4px;
}


/* =========================================================
   MODAL
   ========================================================= */

.modal {
    position: fixed;
    inset: 0;

    background:
        rgba(15,23,42,.65);

    z-index: 100;

    display: flex;

    align-items: flex-end;
    justify-content: center;
}

.modal-box {
    background: white;

    width: 100%;
    max-width: 600px;

    max-height: 92vh;

    overflow-y: auto;

    border-radius: 20px 20px 0 0;

    padding: 20px;
}

.modal-title {
    font-size: 19px;
    font-weight: 800;
    margin-bottom: 16px;
}

.close {
    float: right;

    border: none;

    background: #f1f5f9;

    border-radius: 50%;

    width: 34px;
    height: 34px;

    font-size: 18px;
}

.import-label {
    display: inline-block;
}

.file-input {
    display: none;
}


/* =========================================================
   TOAST
   ========================================================= */

.toast {
    position: fixed;

    bottom: 20px;
    left: 50%;

    transform:
        translateX(-50%)
        translateY(100px);

    background: #0f172a;
    color: white;

    padding: 12px 18px;

    border-radius: 12px;

    z-index: 999;

    font-size: 13px;

    transition: .25s;

    box-shadow:
        0 5px 25px rgba(0,0,0,.25);

    max-width: 90%;

    text-align: center;
}

.toast.show {
    transform:
        translateX(-50%)
        translateY(0);
}


/* =========================================================
   CONFIRM
   ========================================================= */

.confirm-box {
    max-width: 400px;
    margin: auto;
    align-self: center;
}


/* =========================================================
   DESKTOP
   ========================================================= */

@media (min-width: 700px) {

    .container {
        padding: 25px;
    }

    .nav {
        grid-template-columns: repeat(5, 1fr);
    }

    .modal {
        align-items: center;
    }

    .modal-box {
        border-radius: 18px;
    }

    .summary-grid {
        grid-template-columns: repeat(4, 1fr);
    }

}


/* =========================================================
   IMPRESSION
   ========================================================= */

@media print {

    body {
        background: white;
    }

    .app-header,
    .nav,
    .no-print,
    button,
    .button-row {
        display: none !important;
    }

    .container {
        max-width: none;
        padding: 0;
    }

    .card {
        box-shadow: none;
        border: none;
    }

    table {
        min-width: 0;
        font-size: 8px;
    }

    th,
    td {
        padding: 5px;
    }

    .table-container {
        overflow: visible;
        border: none;
    }

    .cycles-result {
        min-width: 0;
    }

}

</style>
</head>


<body>


<!-- =========================================================
     HEADER
     ========================================================= -->

<header class="app-header">

    <div class="header-inner">

        <div class="logo">
            ⚙️ CAPACITY MEASURE
        </div>

        <div class="subtitle">
            Textile Industrial Engineering •
            Capacity Measurement
        </div>

    </div>

</header>


<main class="container">


<!-- =========================================================
     NAVIGATION
     ========================================================= -->

<nav class="nav no-print">

    <button id="navHome"
            class="active"
            onclick="showPage('home')">

        🏠 Accueil

    </button>

    <button id="navStyles"
            onclick="showPage('styles')">

        👕 Styles

    </button>

    <button id="navMeasure"
            onclick="showPage('measure')">

        ⏱️ Mesure

    </button>

    <button id="navResults"
            onclick="showPage('results')">

        📊 Résultats

    </button>

    <button id="navData"
            onclick="showPage('data')">

        💾 Données

    </button>

</nav>


<!-- =========================================================
     PAGE ACCUEIL
     ========================================================= -->

<section id="pageHome">

    <div class="page-title">
        CAPACITY MEASURE
    </div>

    <div class="page-subtitle">
        Mesure de capacité et chronométrage
        des opérations de production.
    </div>


    <div class="summary-grid">

        <div class="summary-box">

            <div class="summary-label">
                Styles enregistrés
            </div>

            <div class="summary-value"
                 id="homeStyleCount">
                0
            </div>

        </div>


        <div class="summary-box">

            <div class="summary-label">
                Opérations
            </div>

            <div class="summary-value"
                 id="homeOperationCount">
                0
            </div>

        </div>


        <div class="summary-box">

            <div class="summary-label">
                Mesures
            </div>

            <div class="summary-value"
                 id="homeMeasurementCount">
                0
            </div>

        </div>


        <div class="summary-box">

            <div class="summary-label">
                Stockage
            </div>

            <div class="summary-value">
                LOCAL
            </div>

        </div>

    </div>


    <div class="card">

        <div class="card-title">
            🚀 Démarrer une mesure
        </div>

        <p style="
            color:#64748b;
            font-size:13px;
        ">

            Sélectionne un style puis
            chronomètre chaque opération
            cycle par cycle.

        </p>


        <button class="btn btn-primary btn-full"
                onclick="startNewMeasurement()">

            ⏱️ NOUVELLE MESURE

        </button>

    </div>


    <div class="card">

        <div class="card-title">
            📋 Fonctionnement
        </div>

        <ol style="
            padding-left:20px;
            color:#475569;
            font-size:13px;
            line-height:1.8;
        ">

            <li>
                Créer ou sélectionner un style.
            </li>

            <li>
                Ajouter les opérations et leurs SMV.
            </li>

            <li>
                Choisir le style dans Nouvelle Mesure.
            </li>

            <li>
                Entrer le nom de l'opérateur.
            </li>

            <li>
                Cliquer sur START puis TOUR
                à chaque cycle.
            </li>

            <li>
                Terminer l'opération puis passer
                à la suivante.
            </li>

            <li>
                Consulter les résultats avec
                le détail de chaque cycle.
            </li>

        </ol>

    </div>

</section>


<!-- =========================================================
     PAGE STYLES
     ========================================================= -->

<section id="pageStyles" class="hidden">

    <div class="page-title">
        Gestion des Styles
    </div>

    <div class="page-subtitle">
        Ta base de données locale des styles
        et opérations.
    </div>


    <div class="button-row no-print"
         style="margin-bottom:15px;">

        <button class="btn btn-primary"
                onclick="openStyleModal()">

            + Nouveau Style

        </button>

    </div>


    <div id="stylesList"></div>

</section>


<!-- =========================================================
     PAGE MESURE
     ========================================================= -->

<section id="pageMeasure" class="hidden">

    <div class="page-title">
        Nouvelle Mesure
    </div>


    <div id="measureSetup"
         class="card">

        <div class="card-title">
            Sélection du Style
        </div>


        <div class="form-group">

            <label for="measureStyle">
                STYLE
            </label>


            <select id="measureStyle"
                    onchange="loadMeasurementStyle()">

                <option value="">
                    -- Sélectionner un style --
                </option>

            </select>

        </div>


        <button class="btn btn-primary btn-full"
                onclick="beginMeasurement()">

            COMMENCER LA MESURE

        </button>

    </div>


    <div id="measurementArea"
         class="hidden">

        <div class="progress">

            <div id="progressBar"
                 class="progress-bar"
                 style="width:0%">
            </div>

        </div>


        <div id="measureOperationCard"></div>

    </div>

</section>


<!-- =========================================================
     PAGE RESULTATS
     ========================================================= -->

<section id="pageResults" class="hidden">

    <div class="page-title">
        Résultats
    </div>

    <div class="page-subtitle">
        Analyse des temps mesurés,
        cycles et capacité opérateur.
    </div>


    <div class="button-row no-print"
         style="margin-bottom:15px;">

        <button class="btn btn-success"
                onclick="exportCSV()">

            📊 Export Excel / CSV

        </button>


        <button class="btn btn-secondary"
                onclick="window.print()">

            🖨️ Imprimer

        </button>

    </div>


    <div id="resultsContent"></div>

</section>


<!-- =========================================================
     PAGE DONNEES
     ========================================================= -->

<section id="pageData" class="hidden">

    <div class="page-title">
        Données
    </div>

    <div class="page-subtitle">
        Sauvegarde et restauration
        de ta base locale.
    </div>


    <div class="card">

        <div class="card-title">
            📤 Exporter les données
        </div>

        <p style="
            font-size:13px;
            color:#64748b;
        ">

            Télécharge tous tes styles,
            opérations et mesures sous forme
            de fichier JSON.

        </p>


        <button class="btn btn-primary btn-full"
                onclick="exportJSON()">

            Télécharger la sauvegarde JSON

        </button>

    </div>


    <div class="card">

        <div class="card-title">
            📥 Importer les données
        </div>

        <p style="
            font-size:13px;
            color:#64748b;
        ">

            Sélectionne un fichier JSON
            précédemment exporté.

        </p>


        <label class="btn btn-success btn-full import-label">

            Choisir un fichier JSON

            <input type="file"
                   id="importFile"
                   class="file-input"
                   accept=".json,application/json"
                   onchange="importJSON(event)">

        </label>

    </div>


    <div class="card">

        <div class="card-title">
            ⚠️ Zone de maintenance
        </div>

        <p style="
            font-size:13px;
            color:#64748b;
        ">

            Cette action supprime définitivement
            les données enregistrées sur ce navigateur.

        </p>


        <button class="btn btn-danger btn-full"
                onclick="clearAllData()">

            SUPPRIMER TOUTES LES DONNÉES

        </button>

    </div>

</section>

</main>


<!-- =========================================================
     MODAL STYLE
     ========================================================= -->

<div id="styleModal"
     class="modal hidden">

    <div class="modal-box">

        <button class="close"
                onclick="closeStyleModal()">

            ×

        </button>


        <div class="modal-title"
             id="styleModalTitle">

            Nouveau Style

        </div>


        <input type="hidden"
               id="editingStyleId">


        <div class="form-group">

            <label>
                Nom du Style
            </label>

            <input id="styleName"
                   type="text"
                   placeholder="Ex: POLO 001">

        </div>


        <div class="form-group">

            <label>
                Client
            </label>

            <input id="styleClient"
                   type="text"
                   placeholder="Ex: Client ABC">

        </div>


        <div class="form-group">

            <label>
                Description
            </label>

            <textarea id="styleDescription"
                      placeholder="Description du style...">
            </textarea>

        </div>


        <button class="btn btn-primary btn-full"
                onclick="saveStyle()">

            ENREGISTRER LE STYLE

        </button>

    </div>

</div>


<!-- =========================================================
     MODAL OPERATIONS
     ========================================================= -->

<div id="operationModal"
     class="modal hidden">

    <div class="modal-box">

        <button class="close"
                onclick="closeOperationModal()">

            ×

        </button>


        <div class="modal-title">
            Ajouter une opération
        </div>


        <input type="hidden"
               id="operationStyleId">

        <input type="hidden"
               id="editingOperationId">


        <div class="form-group">

            <label>
                Nom de l'opération
            </label>

            <input id="operationName"
                   type="text"
                   placeholder="Ex: Attach collar">

        </div>


        <div class="form-group">

            <label>
                SMV (minutes)
            </label>

            <input id="operationSMV"
                   type="number"
                   min="0.01"
                   step="0.01"
                   placeholder="Ex: 0.45">

        </div>


        <button class="btn btn-primary btn-full"
                onclick="saveOperation()">

            ENREGISTRER L'OPÉRATION

        </button>

    </div>

</div>


<!-- =========================================================
     CONFIRMATION
     ========================================================= -->

<div id="confirmModal"
     class="modal hidden">

    <div class="modal-box confirm-box">

        <div class="modal-title"
             id="confirmTitle">

            Confirmation

        </div>


        <p id="confirmMessage"
           style="
           font-size:13px;
           color:#64748b;
           ">
        </p>


        <div class="button-row"
             style="margin-top:20px;">

            <button class="btn btn-secondary"
                    onclick="closeConfirm()">

                Annuler

            </button>


            <button class="btn btn-danger"
                    id="confirmButton">

                Confirmer

            </button>

        </div>

    </div>

</div>


<div id="toast"
     class="toast">
</div>


<script>

/* =========================================================
   CAPACITY MEASURE
   JAVASCRIPT
   ========================================================= */


/* =========================================================
   DATABASE
   ========================================================= */

const DB_KEY =
    "CAPACITY_MEASURE_DATABASE_V1";


let db = {

    styles: [],

    measurements: []

};


/* =========================================================
   MESURE EN COURS
   ========================================================= */

let currentMeasurement = null;


let timerState = {

    running: false,

    startTime: 0,

    animationFrame: null

};


/* =========================================================
   INITIALISATION
   ========================================================= */

document.addEventListener(
    "DOMContentLoaded",
    () => {

        loadDatabase();

        refreshAll();

    }
);


/* =========================================================
   LOCAL STORAGE
   ========================================================= */

function loadDatabase() {

    try {

        const saved =
            localStorage.getItem(DB_KEY);


        if (saved) {

            const parsed =
                JSON.parse(saved);


            db = {

                styles:
                    Array.isArray(parsed.styles)
                        ? parsed.styles
                        : [],

                measurements:
                    Array.isArray(parsed.measurements)
                        ? parsed.measurements
                        : []

            };

        }

    } catch (error) {

        console.error(error);

        showToast(
            "Erreur de lecture des données."
        );

    }

}


function saveDatabase() {

    try {

        localStorage.setItem(
            DB_KEY,
            JSON.stringify(db)
        );

    } catch (error) {

        console.error(error);

        showToast(
            "Impossible de sauvegarder les données."
        );

    }

}


/* =========================================================
   UTILITAIRES
   ========================================================= */

function generateId(prefix = "id") {

    return prefix +
        "_" +
        Date.now() +
        "_" +
        Math.random()
            .toString(36)
            .substring(2, 9);

}


function formatNumber(
    value,
    decimals = 2
) {

    if (!Number.isFinite(value)) {

        return "-";

    }

    return value.toFixed(decimals);

}


function formatTime(seconds) {

    if (!Number.isFinite(seconds)) {

        return "00.000 s";

    }

    return seconds.toFixed(3) + " s";

}


function escapeHTML(value) {

    return String(value ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");

}


/* =========================================================
   NAVIGATION
   ========================================================= */

function showPage(page) {

    const pages = [

        "pageHome",
        "pageStyles",
        "pageMeasure",
        "pageResults",
        "pageData"

    ];


    pages.forEach(id => {

        document
            .getElementById(id)
            .classList.add("hidden");

    });


    const navs = [

        "navHome",
        "navStyles",
        "navMeasure",
        "navResults",
        "navData"

    ];


    navs.forEach(id => {

        document
            .getElementById(id)
            .classList.remove("active");

    });


    const map = {

        home: [
            "pageHome",
            "navHome"
        ],

        styles: [
            "pageStyles",
            "navStyles"
        ],

        measure: [
            "pageMeasure",
            "navMeasure"
        ],

        results: [
            "pageResults",
            "navResults"
        ],

        data: [
            "pageData",
            "navData"
        ]

    };


    if (map[page]) {

        document
            .getElementById(map[page][0])
            .classList.remove("hidden");


        document
            .getElementById(map[page][1])
            .classList.add("active");

    }


    refreshAll();

}


/* =========================================================
   REFRESH
   ========================================================= */

function refreshAll() {

    renderStyles();

    populateStyleSelect();

    renderResults();

    updateHomeStats();

}


/* =========================================================
   HOME STATISTICS
   ========================================================= */

function updateHomeStats() {

    const styles =
        db.styles.length;


    let operations = 0;


    db.styles.forEach(style => {

        operations +=
            Array.isArray(style.operations)
                ? style.operations.length
                : 0;

    });


    document.getElementById(
        "homeStyleCount"
    ).textContent = styles;


    document.getElementById(
        "homeOperationCount"
    ).textContent = operations;


    document.getElementById(
        "homeMeasurementCount"
    ).textContent =
        db.measurements.length;

}


/* =========================================================
   STYLES
   ========================================================= */

function openStyleModal(
    styleId = null
) {

    document
        .getElementById("styleModal")
        .classList.remove("hidden");


    document.getElementById(
        "editingStyleId"
    ).value =
        styleId || "";


    if (styleId) {

        const style =
            db.styles.find(
                s => s.id === styleId
            );


        if (!style) return;


        document.getElementById(
            "styleModalTitle"
        ).textContent =
            "Modifier le Style";


        document.getElementById(
            "styleName"
        ).value =
            style.name;


        document.getElementById(
            "styleClient"
        ).value =
            style.client || "";


        document.getElementById(
            "styleDescription"
        ).value =
            style.description || "";

    } else {

        document.getElementById(
            "styleModalTitle"
        ).textContent =
            "Nouveau Style";


        document.getElementById(
            "styleName"
        ).value = "";


        document.getElementById(
            "styleClient"
        ).value = "";


        document.getElementById(
            "styleDescription"
        ).value = "";

    }

}


function closeStyleModal() {

    document
        .getElementById("styleModal")
        .classList.add("hidden");

}


function saveStyle() {

    const id =
        document.getElementById(
            "editingStyleId"
        ).value;


    const name =
        document.getElementById(
            "styleName"
        ).value.trim();


    const client =
        document.getElementById(
            "styleClient"
        ).value.trim();


    const description =
        document
            .getElementById(
                "styleDescription"
            )
            .value
            .trim();


    if (!name) {

        showToast(
            "Veuillez saisir le nom du style."
        );

        return;

    }


    if (id) {

        const style =
            db.styles.find(
                s => s.id === id
            );


        if (style) {

            style.name = name;

            style.client = client;

            style.description = description;

        }


        showToast(
            "Style modifié."
        );

    } else {

        db.styles.push({

            id:
                generateId("style"),

            name,

            client,

            description,

            operations: [],

            createdAt:
                new Date().toISOString()

        });


        showToast(
            "Style créé."
        );

    }


    saveDatabase();

    closeStyleModal();

    refreshAll();

}


/* =========================================================
   AFFICHAGE STYLES
   ========================================================= */

function renderStyles() {

    const container =
        document.getElementById(
            "stylesList"
        );


    if (db.styles.length === 0) {

        container.innerHTML = `

            <div class="card empty">

                <div class="empty-icon">
                    👕
                </div>

                <strong>
                    Aucun style
                </strong>

                <p>
                    Crée ton premier style
                    pour commencer.
                </p>

            </div>

        `;

        return;

    }


    container.innerHTML =
        db.styles.map(style => {

            const operations =
                Array.isArray(style.operations)
                    ? style.operations
                    : [];


            return `

                <div class="card">

                    <div class="style-card">

                        <div class="style-name">

                            ${escapeHTML(
                                style.name
                            )}

                        </div>


                        <div class="style-client">

                            ${escapeHTML(
                                style.client ||
                                "Client non renseigné"
                            )}

                        </div>


                        ${
                            style.description
                                ?
                                `
                                <div class="style-description">

                                    ${escapeHTML(
                                        style.description
                                    )}

                                </div>
                                `
                                :
                                ""
                        }


                        <div class="operation-count">

                            ${operations.length}
                            opération(s)

                        </div>

                    </div>


                    <div class="button-row no-print"
                         style="margin-bottom:12px;">

                        <button
                            class="btn btn-primary btn-small"
                            onclick="openOperationModal('${style.id}')">

                            + Opération

                        </button>


                        <button
                            class="btn btn-secondary btn-small"
                            onclick="openStyleModal('${style.id}')">

                            Modifier

                        </button>


                        <button
                            class="btn btn-danger btn-small"
                            onclick="deleteStyle('${style.id}')">

                            Supprimer

                        </button>

                    </div>


                    <div>

                        ${
                            operations.length
                            ?

                            operations.map(
                                (op,index) => `

                                    <div class="operation-row">

                                        <div class="operation-info">

                                            <div class="operation-name">

                                                ${index + 1}.
                                                ${escapeHTML(
                                                    op.name
                                                )}

                                            </div>


                                            <div class="smv">

                                                SMV :
                                                ${formatNumber(
                                                    op.smv,
                                                    2
                                                )}
                                                min

                                            </div>

                                        </div>


                                        <div class="operation-actions no-print">

                                            <button
                                                class="btn btn-secondary btn-small"
                                                onclick="openOperationModal('${style.id}','${op.id}')">

                                                ✏️

                                            </button>


                                            <button
                                                class="btn btn-danger btn-small"
                                                onclick="deleteOperation('${style.id}','${op.id}')">

                                                ×

                                            </button>

                                        </div>

                                    </div>

                                `
                            ).join("")

                            :

                            `

                                <div class="empty"
                                     style="padding:20px;">

                                    Aucune opération.

                                </div>

                            `
                        }

                    </div>

                </div>

            `;

        }).join("");

}


/* =========================================================
   SUPPRESSION STYLE
   ========================================================= */

function deleteStyle(styleId) {

    const style =
        db.styles.find(
            s => s.id === styleId
        );


    if (!style) return;


    askConfirmation(

        "Supprimer le style ?",

        `Le style "${style.name}"
         et toutes ses opérations
         seront supprimés.`,

        () => {

            db.styles =
                db.styles.filter(
                    s => s.id !== styleId
                );


            saveDatabase();

            refreshAll();

            showToast(
                "Style supprimé."
            );

        }

    );

}


/* =========================================================
   OPERATIONS
   ========================================================= */

function openOperationModal(
    styleId,
    operationId = null
) {

    document
        .getElementById(
            "operationModal"
        )
        .classList.remove("hidden");


    document.getElementById(
        "operationStyleId"
    ).value =
        styleId;


    document.getElementById(
        "editingOperationId"
    ).value =
        operationId || "";


    const style =
        db.styles.find(
            s => s.id === styleId
        );


    if (!style) return;


    if (operationId) {

        const operation =
            style.operations.find(
                o => o.id === operationId
            );


        if (!operation) return;


        document.getElementById(
            "operationName"
        ).value =
            operation.name;


        document.getElementById(
            "operationSMV"
        ).value =
            operation.smv;

    } else {

        document.getElementById(
            "operationName"
        ).value = "";


        document.getElementById(
            "operationSMV"
        ).value = "";

    }

}


function closeOperationModal() {

    document
        .getElementById(
            "operationModal"
        )
        .classList.add("hidden");

}


function saveOperation() {

    const styleId =
        document.getElementById(
            "operationStyleId"
        ).value;


    const operationId =
        document.getElementById(
            "editingOperationId"
        ).value;


    const name =
        document.getElementById(
            "operationName"
        ).value.trim();


    const smv =
        parseFloat(
            document.getElementById(
                "operationSMV"
            ).value
        );


    if (!name) {

        showToast(
            "Veuillez saisir le nom de l'opération."
        );

        return;

    }


    if (
        !Number.isFinite(smv) ||
        smv <= 0
    ) {

        showToast(
            "Le SMV doit être supérieur à 0."
        );

        return;

    }


    const style =
        db.styles.find(
            s => s.id === styleId
        );


    if (!style) {

        showToast(
            "Style introuvable."
        );

        return;

    }


    if (!Array.isArray(style.operations)) {

        style.operations = [];

    }


    if (operationId) {

        const operation =
            style.operations.find(
                o => o.id === operationId
            );


        if (operation) {

            operation.name =
                name;

            operation.smv =
                smv;

        }


        showToast(
            "Opération modifiée."
        );

    } else {

        style.operations.push({

            id:
                generateId("op"),

            name,

            smv

        });


        showToast(
            "Opération ajoutée."
        );

    }


    saveDatabase();

    closeOperationModal();

    refreshAll();

}


/* =========================================================
   SUPPRESSION OPERATION
   ========================================================= */

function deleteOperation(
    styleId,
    operationId
) {

    const style =
        db.styles.find(
            s => s.id === styleId
        );


    if (!style) return;


    const operation =
        style.operations.find(
            o => o.id === operationId
        );


    if (!operation) return;


    askConfirmation(

        "Supprimer l'opération ?",

        `"${operation.name}"
         sera supprimée du style.`,

        () => {

            style.operations =
                style.operations.filter(
                    o => o.id !== operationId
                );


            saveDatabase();

            refreshAll();

            showToast(
                "Opération supprimée."
            );

        }

    );

}


/* =========================================================
   SELECT STYLE
   ========================================================= */

function populateStyleSelect() {

    const select =
        document.getElementById(
            "measureStyle"
        );


    const currentValue =
        select.value;


    select.innerHTML = `

        <option value="">
            -- Sélectionner un style --
        </option>

    `;


    db.styles.forEach(style => {

        const option =
            document.createElement(
                "option"
            );


        option.value =
            style.id;


        option.textContent =
            style.name +
            (
                style.client
                ?
                " — " + style.client
                :
                ""
            );


        select.appendChild(
            option
        );

    });


    if (
        currentValue &&
        db.styles.some(
            s => s.id === currentValue
        )
    ) {

        select.value =
            currentValue;

    }

}


/* =========================================================
   PREVIEW STYLE
   ========================================================= */

function loadMeasurementStyle() {

    const styleId =
        document.getElementById(
            "measureStyle"
        ).value;


    if (!styleId) return;


    const style =
        db.styles.find(
            s => s.id === styleId
        );


    if (!style) return;


    if (
        !style.operations ||
        !style.operations.length
    ) {

        showToast(
            "Ce style ne contient aucune opération."
        );

    }

}


/* =========================================================
   NOUVELLE MESURE
   ========================================================= */

function startNewMeasurement() {

    showPage("measure");


    document.getElementById(
        "measureSetup"
    ).classList.remove("hidden");


    document.getElementById(
        "measurementArea"
    ).classList.add("hidden");


    document.getElementById(
        "measureStyle"
    ).value = "";

}


function beginMeasurement() {

    const styleId =
        document.getElementById(
            "measureStyle"
        ).value;


    if (!styleId) {

        showToast(
            "Sélectionne un style."
        );

        return;

    }


    const style =
        db.styles.find(
            s => s.id === styleId
        );


    if (!style) {

        showToast(
            "Style introuvable."
        );

        return;

    }


    if (
        !Array.isArray(style.operations) ||
        style.operations.length === 0
    ) {

        showToast(
            "Ajoute d'abord des opérations à ce style."
        );

        return;

    }


    currentMeasurement = {

        id:
            generateId("measurement"),

        styleId:
            style.id,

        styleName:
            style.name,

        client:
            style.client || "",

        startedAt:
            new Date().toISOString(),

        currentOperationIndex:
            0,

        operations:
            style.operations.map(op => ({

                operationId:
                    op.id,

                name:
                    op.name,

                smv:
                    Number(op.smv),

                operator:
                    "",

                cycles:
                    [],

                completed:
                    false

            }))

    };


    document.getElementById(
        "measureSetup"
    ).classList.add("hidden");


    document.getElementById(
        "measurementArea"
    ).classList.remove("hidden");


    renderCurrentMeasurementOperation();

}


/* =========================================================
   RENDER OPERATION
   ========================================================= */

function renderCurrentMeasurementOperation() {

    stopTimer();


    const index =
        currentMeasurement.currentOperationIndex;


    const operation =
        currentMeasurement.operations[index];


    const total =
        currentMeasurement.operations.length;


    const percent =
        ((index) / total) * 100;


    document.getElementById(
        "progressBar"
    ).style.width =
        percent + "%";


    const target =
        60 / operation.smv;


    document.getElementById(
        "measureOperationCard"
    ).innerHTML = `

        <div class="measure-card">

            <div class="measure-number">

                OPÉRATION
                ${index + 1}
                /
                ${total}

            </div>


            <div class="measure-operation">

                ${escapeHTML(
                    operation.name
                )}

            </div>


            <div class="measure-meta">

                <span class="badge badge-white">

                    SMV :
                    ${formatNumber(
                        operation.smv,
                        2
                    )}
                    min

                </span>


                <span class="badge badge-white">

                    100% TARGET :
                    ${formatNumber(
                        target,
                        2
                    )}
                    pcs/h

                </span>

            </div>

        </div>


        <div class="operator-card">

            <div class="form-group">

                <label>
                    NOM DE L'OPÉRATEUR
                </label>


                <input
                    id="operatorName"
                    type="text"
                    value="${escapeHTML(
                        operation.operator
                    )}"
                    placeholder="Nom de l'opérateur">

            </div>


            <div
                id="timerDisplay"
                class="timer timer-stopped">

                00.000 s

            </div>


            <div class="timer-buttons">

                <button
                    id="startLapButton"
                    class="btn btn-success"
                    onclick="startOrLap()">

                    ▶ START / TOUR

                </button>


                <button
                    id="finishButton"
                    class="btn btn-danger"
                    onclick="finishOperation()">

                    ■ TERMINER

                </button>

            </div>


            <div class="cycles-title">

                CYCLES ENREGISTRÉS

            </div>


            <div
                id="cyclesList"
                class="cycles">
            </div>


            <button
                class="btn btn-primary btn-full next-button"
                onclick="nextOperation()">

                OPÉRATION SUIVANTE →

            </button>

        </div>

    `;


    renderCycles();

}


/* =========================================================
   CHRONOMETRE
   ========================================================= */

function startOrLap() {

    const operation =
        currentMeasurement.operations[
            currentMeasurement.currentOperationIndex
        ];


    if (!timerState.running) {

        timerState.running =
            true;


        timerState.startTime =
            performance.now();


        updateTimerDisplay();


        document
            .getElementById(
                "timerDisplay"
            )
            .classList.remove(
                "timer-stopped"
            );


        document
            .getElementById(
                "timerDisplay"
            )
            .classList.add(
                "running"
            );


        document.getElementById(
            "startLapButton"
        ).textContent =
            "⏱️ TOUR";


        return;

    }


    const now =
        performance.now();


    const elapsed =
        (
            now -
            timerState.startTime
        ) / 1000;


    if (elapsed > 0) {

        operation.cycles.push(
            elapsed
        );

    }


    timerState.startTime =
        now;


    renderCycles();

}


function updateTimerDisplay() {

    if (!timerState.running) return;


    const now =
        performance.now();


    const elapsed =
        (
            now -
            timerState.startTime
        ) / 1000;


    const display =
        document.getElementById(
            "timerDisplay"
        );


    if (display) {

        display.textContent =
            formatTime(elapsed);

    }


    timerState.animationFrame =
        requestAnimationFrame(
            updateTimerDisplay
        );

}


/* =========================================================
   STOP TIMER
   ========================================================= */

function stopTimer() {

    timerState.running =
        false;


    if (
        timerState.animationFrame
    ) {

        cancelAnimationFrame(
            timerState.animationFrame
        );


        timerState.animationFrame =
            null;

    }

}


/* =========================================================
   TERMINER OPERATION
   ========================================================= */

function finishOperation() {

    if (!currentMeasurement)
        return;


    const operation =
        currentMeasurement.operations[
            currentMeasurement.currentOperationIndex
        ];


    if (timerState.running) {

        const now =
            performance.now();


        const elapsed =
            (
                now -
                timerState.startTime
            ) / 1000;


        if (elapsed > 0.001) {

            operation.cycles.push(
                elapsed
            );

        }

    }


    stopTimer();


    const operator =
        document.getElementById(
            "operatorName"
        )?.value.trim();


    operation.operator =
        operator ||
        "Non renseigné";


    operation.completed =
        true;


    renderCycles();


    document.getElementById(
        "timerDisplay"
    ).textContent =
        "TERMINÉ";


    document.getElementById(
        "timerDisplay"
    ).classList.remove(
        "running"
    );


    document.getElementById(
        "startLapButton"
    ).disabled =
        true;


    document.getElementById(
        "finishButton"
    ).disabled =
        true;


    showToast(
        `${operation.cycles.length}
         cycle(s) enregistré(s).`
    );

}


/* =========================================================
   CYCLES PENDANT LA MESURE
   ========================================================= */

function renderCycles() {

    const container =
        document.getElementById(
            "cyclesList"
        );


    if (!container) return;


    const operation =
        currentMeasurement.operations[
            currentMeasurement.currentOperationIndex
        ];


    if (!operation.cycles.length) {

        container.innerHTML = `

            <div style="
                color:#94a3b8;
                font-size:12px;
                padding:8px;
                text-align:center;
            ">

                Aucun cycle enregistré.

            </div>

        `;

        return;

    }


    container.innerHTML =
        operation.cycles.map(
            (cycle,index) => `

                <div class="cycle-item">

                    <span>

                        Cycle
                        ${index + 1}

                    </span>


                    <span class="cycle-time">

                        ${formatTime(cycle)}

                    </span>

                </div>

            `
        ).join("");

}


/* =========================================================
   OPERATION SUIVANTE
   ========================================================= */

function nextOperation() {

    if (!currentMeasurement)
        return;


    const operation =
        currentMeasurement.operations[
            currentMeasurement.currentOperationIndex
        ];


    if (timerState.running) {

        showToast(
            "Clique d'abord sur TERMINER."
        );

        return;

    }


    const operatorInput =
        document.getElementById(
            "operatorName"
        );


    if (operatorInput) {

        operation.operator =
            operatorInput.value.trim() ||
            "Non renseigné";

    }


    if (
        !operation.completed &&
        operation.cycles.length === 0
    ) {

        showToast(
            "Mesure au moins un cycle avant de continuer."
        );

        return;

    }


    if (
        currentMeasurement.currentOperationIndex
        <
        currentMeasurement.operations.length - 1
    ) {

        currentMeasurement.currentOperationIndex++;

        renderCurrentMeasurementOperation();

    } else {

        finishMeasurement();

    }

}


/* =========================================================
   FIN MESURE
   ========================================================= */

function finishMeasurement() {

    stopTimer();


    currentMeasurement.finishedAt =
        new Date().toISOString();


    currentMeasurement.completed =
        true;


    db.measurements.push(
        JSON.parse(
            JSON.stringify(
                currentMeasurement
            )
        )
    );


    saveDatabase();


    currentMeasurement =
        null;


    document.getElementById(
        "measurementArea"
    ).classList.add("hidden");


    document.getElementById(
        "measureSetup"
    ).classList.remove("hidden");


    document.getElementById(
        "measureStyle"
    ).value = "";


    renderResults();


    showPage("results");


    showToast(
        "Mesure terminée et enregistrée."
    );

}


/* =========================================================
   CALCUL DES RESULTATS
   ========================================================= */

function calculateOperation(
    operation
) {

    const cycles =
        Array.isArray(
            operation.cycles
        )
        ?
        operation.cycles
        :
        [];


    const avg =
        cycles.length

        ?

        cycles.reduce(
            (sum,value) =>
                sum + value,
            0
        ) / cycles.length

        :

        0;


    const target =
        operation.smv > 0

        ?

        60 / operation.smv

        :

        0;


    const capacity =
        avg > 0

        ?

        3600 / avg

        :

        0;


    const efficiency =
        target > 0

        ?

        (capacity / target) * 100

        :

        0;


    return {

        avg,

        target,

        capacity,

        efficiency

    };

}


/* =========================================================
   AFFICHAGE DES CYCLES DANS LES RESULTATS
   ========================================================= */

function renderCycleTimes(
    cycles
) {

    if (
        !Array.isArray(cycles) ||
        cycles.length === 0
    ) {

        return `
            <span class="cycles-result-empty">
                Aucun cycle
            </span>
        `;

    }


    const average =
        cycles.reduce(
            (sum,value) =>
                sum + value,
            0
        ) / cycles.length;


    const cycleHTML =
        cycles.map(
            (cycle,index) => `

                <span class="cycle-result-badge">

                    C${index + 1} :
                    ${formatTime(cycle)}

                </span>

            `
        ).join("");


    return `

        <div class="cycles-result">

            ${cycleHTML}


            <span class="cycle-result-badge average">

                AVG :
                ${formatTime(average)}

            </span>

        </div>

    `;

}


