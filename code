/* =========================================================
   EXPORT CSV / EXCEL
   ========================================================= */

function exportCSV() {

    if (!db.measurements.length) {

        showToast(
            "Aucun résultat à exporter."
        );

        return;

    }


    const measurement =
        db.measurements[
            db.measurements.length - 1
        ];


    const header = [

        "Style",

        "Client",

        "Operation",

        "Operator",

        "SMV_min",

        "Cycle_1_sec",

        "Cycle_2_sec",

        "Cycle_3_sec",

        "Cycle_4_sec",

        "Cycle_5_sec",

        "Cycle_6_sec",

        "Cycle_7_sec",

        "Cycle_8_sec",

        "Cycle_9_sec",

        "Cycle_10_sec",

        "AVG_sec",

        "100_Target_pcs_h",

        "Capacity_pcs_h",

        "Efficiency_percent",

        "Number_of_cycles"

    ];


    const rows = [
        header
    ];


    measurement.operations.forEach(
        operation => {

            const result =
                calculateOperation(
                    operation
                );


            const cycleColumns = [];


            for (
                let i = 0;
                i < 10;
                i++
            ) {

                cycleColumns.push(
                    operation.cycles[i] ??
                    ""
                );

            }


            rows.push([

                measurement.styleName,

                measurement.client || "",

                operation.name,

                operation.operator || "",

                operation.smv,

                ...cycleColumns,

                result.avg,

                result.target,

                result.capacity,

                result.efficiency,

                operation.cycles.length

            ]);

        }
    );


    const csv =
        rows.map(row =>

            row.map(value => {

                const stringValue =
                    String(value ?? "");


                return '"' +
                    stringValue.replace(
                        /"/g,
                        '""'
                    ) +
                    '"';

            }).join(";")

        ).join("\n");


    const blob =
        new Blob(

            [
                "\uFEFF" +
                csv
            ],

            {
                type:
                    "text/csv;charset=utf-8;"
            }

        );


    downloadBlob(

        blob,

        "capacity_measure_" +
        safeFileName(
            measurement.styleName
        ) +
        ".csv"

    );


    showToast(
        "Fichier CSV exporté."
    );

}


/* =========================================================
   EXPORT JSON
   ========================================================= */

function exportJSON() {

    const data =
        JSON.stringify(
            db,
            null,
            2
        );


    const blob =
        new Blob(

            [data],

            {
                type:
                    "application/json;charset=utf-8"
            }

        );


    const date =
        new Date()
            .toISOString()
            .slice(0,10);


    downloadBlob(

        blob,

        "capacity_measure_backup_" +
        date +
        ".json"

    );


    showToast(
        "Sauvegarde JSON exportée."
    );

}


/* =========================================================
   IMPORT JSON
   ========================================================= */

function importJSON(event) {

    const file =
        event.target.files[0];


    if (!file) return;


    const reader =
        new FileReader();


    reader.onload =
        function(e) {

            try {

                const imported =
                    JSON.parse(
                        e.target.result
                    );


                if (
                    !imported ||
                    !Array.isArray(
                        imported.styles
                    )
                ) {

                    throw new Error(
                        "Format invalide"
                    );

                }


                askConfirmation(

                    "Importer les données ?",

                    "Les données actuelles seront remplacées par le contenu du fichier.",

                    () => {

                        db = {

                            styles:
                                imported.styles ||
                                [],

                            measurements:
                                imported.measurements ||
                                []

                        };


                        saveDatabase();

                        refreshAll();


                        showToast(
                            "Importation terminée."
                        );

                    }

                );

            } catch (error) {

                console.error(error);

                showToast(
                    "Fichier JSON invalide."
                );

            }

        };


    reader.readAsText(file);


    event.target.value = "";

}


/* =========================================================
   DELETE ALL
   ========================================================= */

function clearAllData() {

    askConfirmation(

        "Supprimer toutes les données ?",

        "Cette action supprimera tous les styles, opérations et résultats.",

        () => {

            localStorage.removeItem(
                DB_KEY
            );


            db = {

                styles: [],

                measurements: []

            };


            refreshAll();

            showPage("home");


            showToast(
                "Toutes les données ont été supprimées."
            );

        }

    );

}


/* =========================================================
   CONFIRMATION
   ========================================================= */

let confirmationCallback =
    null;


function askConfirmation(
    title,
    message,
    callback
) {

    document.getElementById(
        "confirmTitle"
    ).textContent =
        title;


    document.getElementById(
        "confirmMessage"
    ).textContent =
        message;


    confirmationCallback =
        callback;


    document
        .getElementById(
            "confirmModal"
        )
        .classList.remove(
            "hidden"
        );


    document.getElementById(
        "confirmButton"
    ).onclick =
        () => {

            if (
                confirmationCallback
            ) {

                confirmationCallback();

            }

            closeConfirm();

        };

}


function closeConfirm() {

    document
        .getElementById(
            "confirmModal"
        )
        .classList.add(
            "hidden"
        );


    confirmationCallback =
        null;

}


/* =========================================================
   DOWNLOAD
   ========================================================= */

function downloadBlob(
    blob,
    filename
) {

    const url =
        URL.createObjectURL(
            blob
        );


    const link =
        document.createElement(
            "a"
        );


    link.href =
        url;


    link.download =
        filename;


    document.body.appendChild(
        link
    );


    link.click();


    link.remove();


    setTimeout(
        () => {

            URL.revokeObjectURL(
                url
            );

        },
        1000
    );

}


function safeFileName(name) {

    return String(
        name || "style"
    )
    .replace(
        /[^a-z0-9_\-]/gi,
        "_"
    )
    .substring(
        0,
        80
    );

}


/* =========================================================
   TOAST
   ========================================================= */

let toastTimer;


function showToast(message) {

    const toast =
        document.getElementById(
            "toast"
        );


    toast.textContent =
        message;


    toast.classList.add(
        "show"
    );


    clearTimeout(
        toastTimer
    );


    toastTimer =
        setTimeout(
            () => {

                toast.classList.remove(
                    "show"
                );

            },
            2500
        );

}


/* =========================================================
   PREVENT ACCIDENTAL PAGE REFRESH
   ========================================================= */

window.addEventListener(
    "beforeunload",
    function(event) {

        if (
            currentMeasurement &&
            timerState.running
        ) {

            event.preventDefault();

            event.returnValue = "";

        }

    }
);


/* =========================================================
   GESTION VISIBILITE TELEPHONE
   ========================================================= */

document.addEventListener(
    "visibilitychange",
    () => {

        if (
            !document.hidden &&
            timerState.running
        ) {

            updateTimerDisplay();

        }

    }
);

